# Scope -> registry mapping. Safe to commit: it contains no credentials.
# The auth token belongs in your user-level ~/.npmrc:
#   //192.168.237.68:8021/api/packages/GlobemedGroup/npm/:_authToken=<Gitea token with read:package, write:package>
@globemed:registry=http://192.168.237.68:8021/api/packages/GlobemedGroup/npm/
