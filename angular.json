{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "genix-ui": {
      "projectType": "library",
      "root": "projects/genix-ui",
      "sourceRoot": "projects/genix-ui/src",
      "prefix": "gm",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/genix-ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/genix-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/genix-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/genix-ui/tsconfig.spec.json",
            "inlineStyleLanguage": "scss"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "genix-ui:storybook-build",
            "tsConfig": "projects/genix-ui/tsconfig.storybook.json",
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "genix-ui:storybook-build",
            "tsConfig": "projects/genix-ui/tsconfig.storybook.json",
            "compodoc": false,
            "outputDir": "dist/storybook/genix-ui"
          }
        },
        "storybook-build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/genix-ui-storybook-shell",
            "index": "projects/genix-ui/.storybook-shell/index.html",
            "main": "projects/genix-ui/.storybook-shell/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/genix-ui/tsconfig.storybook.json",
            "inlineStyleLanguage": "scss",
            "styles": ["projects/genix-ui/styles/tokens.css"]
          },
          "configurations": {
            "production": { "optimization": true },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "playground": {
      "projectType": "application",
      "root": "projects/playground",
      "sourceRoot": "projects/playground/src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/playground",
            "index": "projects/playground/src/index.html",
            "browser": "projects/playground/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/playground/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "dist/genix-ui/styles/tokens.css",
              "projects/playground/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1500kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4300
          },
          "configurations": {
            "production": { "buildTarget": "playground:build:production" },
            "development": { "buildTarget": "playground:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
