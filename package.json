{
  "name": "genix-ui-workspace",
  "version": "0.0.0",
  "description": "Development workspace for the Genix UI Angular component library. The publishable package is projects/genix-ui.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build genix-ui",
    "watch": "ng build genix-ui --watch --configuration development",
    "test": "ng test genix-ui --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test genix-ui",
    "start": "npm run build && ng serve playground",
    "build:playground": "npm run build && ng build playground",
    "pack:lib": "npm run build && npm pack ./dist/genix-ui --pack-destination dist",
    "publish:dry": "npm run build && npm publish ./dist/genix-ui --dry-run",
    "publish:lib": "npm run build && npm publish ./dist/genix-ui"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cdk": "^19.2.19",
    "@angular/cli": "^19.2.15",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/compiler-cli": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2",
    "zone.js": "~0.15.0"
  }
}
